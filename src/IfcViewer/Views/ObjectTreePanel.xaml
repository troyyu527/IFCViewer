<UserControl x:Class="IfcViewer.Views.ObjectTreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="White">
        <TextBlock DockPanel.Dock="Top" Text="Object Tree" FontWeight="SemiBold" FontSize="14"
                   Padding="10,8" Background="#FFE8E8E8" />

        <!-- Search by ID: type, then Enter or the search icon. Nothing happens while typing. -->
        <StackPanel DockPanel.Dock="Top" Margin="8,6,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Padding="4,3" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search ID">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <!-- Grey hint while the box is empty; clicks go through to the box -->
                <TextBlock Grid.Column="0" Text="Search ID…" Foreground="#FF9A9A9A" Margin="7,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Segoe MDL2 Assets E721 = search (magnifier) -->
                <Button Grid.Column="1" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Width="28" Margin="4,0,0,0" ToolTip="Search" Command="{Binding SearchCommand}"
                        AutomationProperties.Name="Search" />
            </Grid>
            <TextBlock Text="{Binding SearchMessage}" Foreground="#FF9A5B00" Margin="2,3,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" BorderThickness="0" Padding="2,4"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard">
            <TreeView.Resources>
                <!-- The TreeView's own single selection is made invisible; the multi-selection is drawn by the
                     item template from TreeNodeViewModel.IsSelected instead -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
            </TreeView.Resources>

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Border x:Name="Row" Padding="4,1" CornerRadius="2" Background="Transparent"
                            MouseLeftButtonDown="OnRowMouseLeftButtonDown">
                        <TextBlock x:Name="RowText" Text="{Binding Name}" />
                    </Border>
                    <HierarchicalDataTemplate.Triggers>
                        <!-- Same blue as the 3D highlight -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#FF3D8CFF" />
                            <Setter TargetName="RowText" Property="Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter TargetName="RowText" Property="Foreground" Value="#FF9A9A9A" />
                            <Setter TargetName="RowText" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
