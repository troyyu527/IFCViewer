<Window x:Class="IfcViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IfcViewer.Views"
        xmlns:infra="clr-namespace:IfcViewer.Infrastructure"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="{Binding WindowTitle}" Width="1280" Height="800"
        Icon="/Assets/IfcViewer.ico"
        WindowStartupLocation="CenterScreen">
    <!-- Ctrl+O works everywhere; F (Fit to View) and Esc (clear selection) are handled in code-behind,
         so they don't fire while typing in the search box -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:NotConverter x:Key="Not" />

        <!-- Right click on an element. DataContext (ViewerViewModel) is set when the menu opens;
             a command that can't execute greys its item out. -->
        <ContextMenu x:Key="ElementMenu">
            <MenuItem Header="Isolate Selected Elements" Command="{Binding IsolateSelectedCommand}" />
            <MenuItem Header="Hide Selected Elements" Command="{Binding HideSelectedCommand}" />
            <MenuItem Header="Reset" Command="{Binding ResetVisibilityCommand}" />
        </ContextMenu>
        <!-- Right click on empty space -->
        <ContextMenu x:Key="BackgroundMenu">
            <MenuItem Header="Reset" Command="{Binding ResetVisibilityCommand}" />
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <!-- No dashed focus frame around the toolbar after keyboard use (it gets the focus back after dialogs) -->
        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True" FocusVisualStyle="{x:Null}">
            <Button Content="Open IFC" Command="{Binding OpenCommand}" Padding="8,2" ToolTip="Open an IFC file (Ctrl+O)" />
            <Button Content="Fit to View" Command="{Binding FitToViewCommand}" Padding="8,2" ToolTip="Show the whole model (F)" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="200" Height="14" Maximum="100" Value="{Binding Progress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Named: their widths are remembered between runs -->
                <ColumnDefinition x:Name="TreeColumn" Width="260" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="350" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Panels are disabled while a file loads: the old model is being replaced -->
            <views:ObjectTreePanel Grid.Column="0" DataContext="{Binding Tree}"
                                   IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Not}}" />

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FFD0D0D0" />

            <!-- Navigation: left-drag rotate, right-drag pan, wheel zoom. Helix defaults are turned off.
                 No focus rectangle: Helix focuses the viewport on every mouse press, and WPF would draw a dashed
                 frame around the 3D view after any key press (e.g. Esc to close the context menu). -->

            <hx:Viewport3DX x:Name="Viewport" Grid.Column="2"
                            EffectsManager="{Binding Viewer.EffectsManager}"
                            Camera="{Binding Viewer.Camera}"
                            BackgroundColor="#FFF0F0F0"
                            FocusVisualStyle="{x:Null}"
                            ModelUpDirection="0,0,1"
                            UseDefaultGestures="False"
                            IsInertiaEnabled="False"
                            ShowViewCube="False"
                            ShowCoordinateSystem="False"
                            FixedRotationPointEnabled="True"
                            FixedRotationPoint="{Binding Viewer.RotationPivot}">
                <hx:Viewport3DX.InputBindings>
                    <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="LeftClick" />
                    <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="RightClick" />
                    <!-- Gestures match only the exact modifier keys: keep navigating while Ctrl is held (multi-select) -->
                    <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="Ctrl+LeftClick" />
                    <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="Ctrl+RightClick" />
                </hx:Viewport3DX.InputBindings>

                <hx:AmbientLight3D Color="#FF505050" />
                <!-- Headlight: always shines from the camera -->
                <hx:DirectionalLight3D Color="#FFD0D0D0" Direction="{Binding Viewer.Camera.LookDirection}" />

                <hx:GroupModel3D ItemsSource="{Binding Viewer.SceneModels}" />
                <!-- Selection highlight, drawn after the scene -->
                <hx:GroupModel3D ItemsSource="{Binding Viewer.OverlayModels}" />
            </hx:Viewport3DX>

            <!-- Empty state: shown until a model is loaded; mouse clicks go through to the viewport -->
            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       FontSize="16" Foreground="#FF8A8A8A" TextAlignment="Center"
                       Visibility="{Binding HasModel, Converter={StaticResource Not}, ConverterParameter=Visibility}">
                Click 'Open IFC' (Ctrl+O) to load a model
            </TextBlock>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#FFD0D0D0" />

            <views:PropertiesPanel Grid.Column="4" DataContext="{Binding Properties}"
                                   IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Not}}" />
        </Grid>
    </DockPanel>
</Window>
